APP_NAME=LudoDex
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# The SPA's own URL (Cloudflare Pages in production), used to build the
# password reset link - see App\Providers\AppServiceProvider.
FRONTEND_URL=http://localhost:5173

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# `log` writes password-reset emails to storage/logs instead of sending
# them - fine for local dev, but production needs a real mailer for the
# reset link to actually reach anyone. To use Resend (free tier covers
# this app's volume): sign up at https://resend.com, verify a sending
# domain (or use their onboarding@resend.dev sender for testing), then
# set MAIL_MAILER=resend, RESEND_API_KEY=<your key>, and a MAIL_FROM_ADDRESS
# on your verified domain.
RESEND_API_KEY=

# BoardGameGeek now requires a registered application token (the public,
# unauthenticated XML API no longer exists). Register at
# https://boardgamegeek.com/using_the_xml_api to obtain one - without it,
# every BGG import request fails with a 401.
BGG_APPLICATION_TOKEN=

# Optional: translates a game's BGG description to Spanish on demand (see
# GameDescriptionController). Get a free-plan key at
# https://www.deepl.com/en/signup?product=api_free - without one, the
# description just stays in English with an "EN" badge in the UI.
DEEPL_API_KEY=

# Optional, local-only: lets `php artisan translations:sync` copy
# description_es between this database and production, in both directions,
# without spending DeepL quota re-translating the same games twice. The
# token is a normal Sanctum token for your own account (grab it from
# localStorage in an already logged-in production tab, key "ludodex_token").
PROD_API_URL=
PROD_API_TOKEN=

# Required in production for POST /api/games/backfill-translations (see
# GameTranslationBackfillController) to accept anything - must match the
# email of the account that owns this deployment, since any other
# authenticated account is rejected with a 403.
OWNER_EMAIL=
